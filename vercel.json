{
  "rewrites": [
    {
      "source": "/features",
      "destination": "/features/index.html"
    },
    {
      "source": "/da-tracking",
      "destination": "/da-tracking/index.html"
    },
    {
      "source": "/time-and-invoicing",
      "destination": "/time-and-invoicing/index.html"
    },
    {
      "source": "/documents-and-templates",
      "destination": "/documents-and-templates/index.html"
    },
    {
      "source": "/integrations",
      "destination": "/integrations/index.html"
    },
    {
      "source": "/import-old-jobs",
      "destination": "/import-old-jobs/index.html"
    },
    {
      "source": "/security",
      "destination": "/security/index.html"
    },
    {
      "source": "/business-day-calculator",
      "destination": "/business-day-calculator/index.html"
    },
    {
      "source": "/da-timeframes-queensland",
      "destination": "/da-timeframes-queensland/index.html"
    },
    {
      "source": "/faq",
      "destination": "/faq/index.html"
    },
    {
      "source": "/contact",
      "destination": "/contact/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/app.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    }
  ]
}
